{
  "uid": "triagem-api",
  "title": "Triagem de Laudos — API",
  "tags": [
    "tech-challenge",
    "triagem"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total de requisições /predict por status",
      "description": "Contadores desde o início de cada processo da API. Reiniciar a API zera os contadores.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (triagem_http_requests_total{job=\"triagem-api\",route=\"/predict\"})",
          "legendFormat": "HTTP {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Latência HTTP /predict — P50 e P95",
      "description": "Duração HTTP completa em segundos. Percentis estimados pelos buckets do histograma.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(triagem_http_request_duration_seconds_bucket{job=\"triagem-api\",route=\"/predict\"}[$__rate_interval])))",
          "legendFormat": "P50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(triagem_http_request_duration_seconds_bucket{job=\"triagem-api\",route=\"/predict\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Taxa de erro /predict — HTTP 4xx e 5xx",
      "description": "Proporção de respostas 4xx e 5xx. Inclui falhas de validação 422 geradas pela demonstração.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(triagem_http_requests_total{job=\"triagem-api\",route=\"/predict\",status=~\"[45]..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(triagem_http_requests_total{job=\"triagem-api\",route=\"/predict\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "Erros / chamadas",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
