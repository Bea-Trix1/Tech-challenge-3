# API de inferência: serve models/model.onnx em /predict e expõe /metrics/latency.
#
# O contexto de build é a RAIZ do repositório (precisa de src/ e models/):
#   docker build -f docker/fastapi/dockerfile -t triagem-api .
#   docker compose -f docker/fastapi/docker-compose.yml up --build

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ORT_INTRA_OP_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MODEL_PATH=/app/models/model.onnx

WORKDIR /app

# O StringNormalizer (lowercase do TF-IDF) usa tolower() do C: precisa de locale UTF-8.
RUN apt-get update && \
    apt-get install -y --no-install-recommends locales && \
    sed -i 's/# en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen && \
    locale-gen && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --create-home --uid 10001 appuser
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

COPY docker/fastapi/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Só o necessário para servir: pacote + API + modelo (train.py/export_onnx.py ficam fora).
COPY --chown=appuser:appuser src/__init__.py ./src/__init__.py
COPY --chown=appuser:appuser src/api.py ./src/api.py
COPY --chown=appuser:appuser models/model.onnx ./models/model.onnx

USER appuser
EXPOSE 8000

# /health carrega o modelo: se responder 200, a sessão ONNX está pronta.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).read()"]

# 1 worker: latência previsível (sem disputa entre processos) e 1 cópia do modelo em memória.
# Sem --reload (recria o app a cada request); sem --workers > 1.
CMD ["uvicorn", "src.api:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "1", \
     "--loop", "uvloop", \
     "--http", "httptools", \
     "--no-access-log"]